@page "/familias/novo/{Nome}&{Cpf}&{Nis}"
@using SisCras.Presentation.Components.Shared
;
@inject RegistroViewModel ViewModel

@foreach (FamiliaUsuario usuario in @ViewModel.FamiliaUsuarios)
{
    <MembroFamilia UsuarioModel="usuario" ComponentMode="MembroFamiliaTypeEnum.Edicao" DeactivateClicked="ViewModel.DeactivateUsuarioCommand.ExecuteAsync" />
}

<button value="Salvar alterações" @onclick="@ViewModel.UpdateProntuarioCommand.ExecuteAsync"/>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}