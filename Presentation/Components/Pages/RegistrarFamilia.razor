@page "/familias/novo"
@using SisCras.Presentation.Components.Shared
@inject RegistroViewModel ViewModel

<EditForm Model="ViewModel.Prontuario" OnValidSubmit="ViewModel.InsertNewProntuarioCommand.ExecuteAsync">
    
    <FluentValidationValidator />
    
    <ValidationSummary class="text-danger mb-3" />

    <div class="d-flex justify-content-end mb-3">
        <button type="button" class="btn btn-outline-secondary" @onclick="@ViewModel.CreateNewUsuarioCommand.ExecuteAsync">
            <i class="bi bi-person-plus"></i> Adicionar Membro
        </button>
    </div>

    @foreach (var usuario in ViewModel.Prontuario.Familia.FamiliaUsuarios)
    {
        <MembroFamilia UsuarioModel="usuario" 
                       CanSearchUsuario="@ViewModel.VerifyDuplicateCommand.Execute"/>
    }

    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg w-100">
            Cadastrar família
        </button>
    </div>

</EditForm>

<HxModal @ref="ViewModel.DuplicateModal">
    <HeaderTemplate>
        <h2>Usuário encontrado</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p>Nome: @ViewModel.UsuarioForModal?.Usuario?.Nome</p>
        <p>CPF: @ViewModel.UsuarioForModal?.Usuario?.Cpf</p>
        <p>NIS: @ViewModel.UsuarioForModal?.Usuario?.Nis</p>
        <p>CRAS: @ViewModel.UsuarioForModal?.Familia?.Prontuarios?.FirstOrDefault(p => p.DataSaida == null)?.Cras?.Nome</p>
        
        <div class="alert alert-info">
            Deseja importar este usuário para a família atual? 
            Isso irá removê-lo da família anterior ao concluir o cadastro.
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" 
                @onclick="async () => await ViewModel.DuplicateModal.HideAsync()">
            Cancelar
        </button>
        <button type="button" class="btn btn-success" 
                @onclick="@ViewModel.ImportUsuarioDataCommand.ExecuteAsync">
            Importar Dados
        </button>
    </FooterTemplate>
</HxModal>

<button @onclick="@ViewModel.InsertNewProntuarioCommand.ExecuteAsync" class="btn-primary btn">Cadastrar família</button>

@code {
    [SupplyParameterFromQuery(Name = "nome")]
    public string Nome { get; set; }

    [SupplyParameterFromQuery(Name = "cpf")]
    public string Cpf { get; set; }

    [SupplyParameterFromQuery(Name = "nis")]
    public string Nis { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.CreateNewUsuarioCommand.ExecuteAsync(null);
    }

}
