@page "/familias/novo"
@using SisCras.Presentation.Components.Shared
@inject RegistroViewModel ViewModel

<button @onclick="@ViewModel.CreateNewUsuarioCommand.ExecuteAsync"><i class="bi bi-person-plus"></i></button>

@foreach (var usuario in ViewModel.Prontuario.Familia.FamiliaUsuarios)
{
    <MembroFamilia UsuarioModel="usuario" CanSearchUsuario="@ViewModel.VerifyDuplicateCommand.Execute"/>
}

<HxModal @ref="ViewModel.DuplicateModal">
    <HeaderTemplate>
        <h2>Usuário encontrado</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p>Nome: @ViewModel.UsuarioForModal.Usuario.Nome</p>
        <p>CPF: @ViewModel.UsuarioForModal.Usuario.Cpf</p>
        <p>NIS: @ViewModel.UsuarioForModal.Usuario.Nis</p>
        <p>CRAS: @ViewModel.UsuarioForModal.Familia.Prontuarios.FirstOrDefault(p => p.DataSaida == null).Cras.Nome</p>
    </BodyTemplate>
    <FooterTemplate>
        <button @onclick="() => Debug.WriteLine(ViewModel.Usuario.Nome)">Fazer o role</button>
    </FooterTemplate>
</HxModal>

<button @onclick="@ViewModel.InsertNewProntuarioCommand.ExecuteAsync" class="btn-primary btn">Cadastrar família</button>

@code {

    [SupplyParameterFromQuery(Name = "nome")]
    public string Nome { get; set; }

    [SupplyParameterFromQuery(Name = "cpf")]
    public string Cpf { get; set; }

    [SupplyParameterFromQuery(Name = "nis")]
    public string Nis { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.CreateNewUsuarioCommand.ExecuteAsync(null);
    }

}
