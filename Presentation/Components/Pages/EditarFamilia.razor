@page "/familias/{PagePath}/{FamiliaId:int}"
@using SisCras.Presentation.Components.Shared
@inject EditarFamiliaViewModel ViewModel

@if (PageMode == MembroFamiliaTypeEnum.Editar)
{
    <button @onclick="@ViewModel.CreateNewUsuarioCommand.ExecuteAsync"><i class="bi bi-person-plus"></i></button>
}

<label for="chkb_ativos">Mostrar usuários inativos:</label>
<input id="chkb_ativos" type="checkbox" @bind="ViewModel.ShowUnactiveUsuarios"/>

@if (ViewModel.Usuarios.Count == 0 && ViewModel.ShowUnactiveUsuarios)
{
    <div class="card mb-4">
        <h5 class="card-title mb-0">Nenhum usuário nessa família</h5>
    </div>  
}
else if (ViewModel.Usuarios.Count == 0 && !ViewModel.ShowUnactiveUsuarios)
{
    <div class="card mb-4 flex">
        <h3 class="card-title mb-0 text-center">Nenhum usuário ativo nessa família</h3>
    </div>  
}
else 
{
    @foreach (var usuario in (from fu in ViewModel.Usuarios orderby fu.Ativo select fu))
    {
        <MembroFamilia UsuarioModel="usuario" ComponentMode="PageMode"
                       DeactivateClicked="ViewModel.DeactivateUsuarioCommand.ExecuteAsync">
        </MembroFamilia>
    }
}

@if (PageMode == MembroFamiliaTypeEnum.Editar)
{
    <button class="btn btn-warning" @onclick="() => ViewModel.UpdateProntuarioCommand.ExecuteAsync(ViewModel.SelectedProntuario)">Editar</button>
}
else
{
    <button disabled="disabled" class="btn btn-warning" @onclick="() => ViewModel.UpdateProntuarioCommand.ExecuteAsync(ViewModel.SelectedProntuario)">Editar</button>
}

@code {
    [Parameter] public int FamiliaId { get; set; }
    [Parameter] public string PagePath { get; set; }
    
    public MembroFamiliaTypeEnum PageMode
    {
        get
        {
            MembroFamiliaTypeEnum tempEnum = MembroFamiliaTypeEnum.Visualizar;
            switch (PagePath)
            {
                case "editar":
                    tempEnum = MembroFamiliaTypeEnum.Editar;
                    break;
                case "visualizar":
                    tempEnum = MembroFamiliaTypeEnum.Visualizar;
                    break;
                case "registrar":
                    tempEnum = MembroFamiliaTypeEnum.Registrar;
                    break;
            }
            return tempEnum;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.GetProntuario(FamiliaId);
    }
}
