@page "/familias/{PagePath}/{FamiliaId:int}"
@using SisCras.Presentation.Components.Shared
@inject EditarFamiliaViewModel ViewModel

<EditForm Model="ViewModel.SelectedProntuario" OnValidSubmit="ViewModel.UpdateProntuarioCommand.ExecuteAsync">
    
    <FluentValidationValidator />
    
    <ValidationSummary class="text-danger mb-3" />
    
    @if (PageMode == MembroFamiliaTypeEnum.Editar)
    {
        <div class="d-flex justify-content-start mb-1 mt-3">
            <button type="button" class="btn btn-outline-secondary" @onclick="@ViewModel.CreateNewUsuarioCommand.ExecuteAsync">
                <i class="bi bi-person-plus"></i> Adicionar Membro
            </button>
        </div>   
    }

    @foreach (var usuario in ViewModel.SelectedProntuario.Familia.FamiliaUsuarios)
    {
        <MembroFamilia UsuarioModel="usuario" ComponentMode="PageMode"
                       CanSearchUsuario="ViewModel.VerifyDuplicateCommand.ExecuteAsync"
                       DeactivateClicked="ViewModel.DeactivateUsuarioCommand.ExecuteAsync"/>
    }

    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg w-100">
            Cadastrar família
        </button>
    </div>

</EditForm>

<HxModal @ref="ViewModel.DuplicateModal">
    <HeaderTemplate>
        <h2>Usuário encontrado</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p>Nome: @ViewModel.UsuarioForModal?.Usuario?.Nome</p>
        <p>CPF: @ViewModel.UsuarioForModal?.Usuario?.Cpf</p>
        <p>NIS: @ViewModel.UsuarioForModal?.Usuario?.Nis</p>
        <p>CRAS: @ViewModel.UsuarioForModal?.Familia?.Prontuarios?.FirstOrDefault(p => p.DataSaida == null)?.Cras?.Nome</p>
        
        <div class="alert alert-info">
            Deseja importar este usuário para a família atual? 
            Isso irá removê-lo da família anterior ao concluir o cadastro.
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" 
                @onclick="async () => await ViewModel.DuplicateModal.HideAsync()">
            Cancelar
        </button>
        <button type="button" class="btn btn-success" 
                @onclick="@ViewModel.ImportUsuarioDataCommand.ExecuteAsync">
            Importar Dados
        </button>
    </FooterTemplate>
</HxModal>

@code {
    [Parameter] public int FamiliaId { get; set; }
    [Parameter] public string PagePath { get; set; }
    
    public MembroFamiliaTypeEnum PageMode
    {
        get
        {
            MembroFamiliaTypeEnum tempEnum = MembroFamiliaTypeEnum.Visualizar;
            switch (PagePath)
            {
                case "editar":
                    tempEnum = MembroFamiliaTypeEnum.Editar;
                    break;
                case "visualizar":
                    tempEnum = MembroFamiliaTypeEnum.Visualizar;
                    break;
                case "registrar":
                    tempEnum = MembroFamiliaTypeEnum.Registrar;
                    break;
                default:
                    tempEnum = MembroFamiliaTypeEnum.Visualizar;
                    break;
            }
            return tempEnum;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Task.Run(async () => await ViewModel.GetProntuario(FamiliaId));
    }
}
