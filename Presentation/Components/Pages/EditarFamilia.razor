@page "/familias/{PagePath}/{FamiliaId:int}"
@using SisCras.Presentation.Components.Shared
@inject EditarFamiliaViewModel ViewModel

<EditForm Model="ViewModel.SelectedProntuario" OnValidSubmit="ViewModel.UpdateProntuarioCommand.ExecuteAsync">
    
    <FluentValidationValidator />
    
    @if (PageMode == MembroFamiliaTypeEnum.Editar)
    {
        <div class="d-flex justify-content-between align-items-center mb-3 mt-3">
            <button type="button" class="btn btn-outline-secondary" @onclick="@ViewModel.CreateNewUsuarioCommand.ExecuteAsync">
                <i class="bi bi-person-plus"></i> Adicionar Membro
            </button>
            
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="chkb_ativos" @bind="ViewModel.ShowUnactiveUsuarios">
                <label class="form-check-label" for="chkb_ativos">Mostrar usuários inativos</label>
            </div>
        </div>  
    }
    else 
    {
        <div class="d-flex justify-content-end mb-3 mt-3">
            <div class="">
                <input class="" type="checkbox" id="chkb_ativos" @bind="ViewModel.ShowUnactiveUsuarios">
                <label class="" for="chkb_ativos">Mostrar usuários inativos</label>
            </div>
        </div>
    }

    @if (ViewModel.Usuarios.Count == 0 && ViewModel.ShowUnactiveUsuarios)
    {
        <div class="card mb-4">
            <div class="card-body text-center">
                <h5 class="card-title mb-0 text-muted">Nenhum usuário nessa família</h5>
            </div>
        </div>  
    }
    else if (ViewModel.Usuarios.Count == 0 && !ViewModel.ShowUnactiveUsuarios)
    {
        <div class="card mb-4">
            <div class="card-body text-center">
                <h5 class="card-title mb-0 text-muted">Nenhum usuário ativo nessa família</h5>
            </div>
        </div>  
    }
    else 
    {
        @foreach (var usuario in ViewModel.Usuarios)
        {
            <MembroFamilia UsuarioModel="usuario" 
                           ComponentMode="PageMode"
                           CanSearchUsuario="ViewModel.VerifyDuplicateCommand.ExecuteAsync"
                           DeactivateClicked="ViewModel.DeactivateUsuarioCommand.ExecuteAsync"/>
        }
    }

    <div class="mt-4">
        <button type="submit" class="btn btn-primary btn-lg w-100">
            Editar família
        </button>
    </div>

</EditForm>

<HxModal @ref="ViewModel.DuplicateModal">
    <HeaderTemplate>
        <h2>Usuário encontrado</h2>
    </HeaderTemplate>
    <BodyTemplate>
        <p>Nome: @ViewModel.UsuarioForModal?.Usuario?.Nome</p>
        <p>CPF: @ViewModel.UsuarioForModal?.Usuario?.Cpf</p>
        <p>NIS: @ViewModel.UsuarioForModal?.Usuario?.Nis</p>
        <p>CRAS: @ViewModel.UsuarioForModal?.Familia?.Prontuarios?.FirstOrDefault(p => p.DataSaida == null)?.Cras?.Nome</p>
        
        <div class="alert alert-info">
            Deseja importar este usuário para a família atual? 
            Isso irá removê-lo da família anterior ao concluir o cadastro.
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" 
                @onclick="async () => await ViewModel.DuplicateModal.HideAsync()">
            Cancelar
        </button>
        <button type="button" class="btn btn-success" 
                @onclick="@ViewModel.ImportUsuarioDataCommand.ExecuteAsync">
            Importar Dados
        </button>
    </FooterTemplate>
</HxModal>

@code {
    [Parameter] public int FamiliaId { get; set; }
    [Parameter] public string PagePath { get; set; }
    
    public MembroFamiliaTypeEnum PageMode
    {
        get
        {
            MembroFamiliaTypeEnum tempEnum = MembroFamiliaTypeEnum.Visualizar;
            switch (PagePath)
            {
                case "editar":
                    tempEnum = MembroFamiliaTypeEnum.Editar;
                    break;
                case "visualizar":
                    tempEnum = MembroFamiliaTypeEnum.Visualizar;
                    break;
                case "registrar":
                    tempEnum = MembroFamiliaTypeEnum.Registrar;
                    break;
                default:
                    tempEnum = MembroFamiliaTypeEnum.Visualizar;
                    break;
            }
            return tempEnum;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.GetProntuario(FamiliaId);
    }
}
