@page "/familias"
@using SisCras.Presentation.Components.Shared
@inject FamiliaViewModel ViewModel
@inject NavigationManager NavigationManager

<PageTitle>Busca de Famílias</PageTitle>

<h3>Busca de Famílias</h3>

<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Nome do usuário" 
           @bind="ViewModel.SearchUsuario.Nome"
           @onfocusout="@ViewModel.SearchFamiliasByUsuarioCommand.ExecuteAsync"/>
    <input type="text" class="form-control" placeholder="CPF do usuário" 
           @bind="ViewModel.SearchUsuario.Cpf"
           @onfocusout="@ViewModel.SearchFamiliasByUsuarioCommand.ExecuteAsync"/>
    <input type="text" class="form-control" placeholder="NIS do usuário" 
           @bind="ViewModel.SearchUsuario.Nis"
           @onfocusout="@ViewModel.SearchFamiliasByUsuarioCommand.ExecuteAsync"/>
    <button class="btn btn-primary" type="button" @onclick="ViewModel.SearchFamiliasByUsuarioCommand.ExecuteAsync">
        Buscar
    </button>
</div>

<button class="btn btn-success mb-3" @onclick="ViewModel.GoToRegistrarFamiliaCommand.ExecuteAsync">Registrar Nova
    Família
</button>

@if (ViewModel.Prontuarios.Count == 0)
{
    <p>Nenhum prontuário encontrado</p>
}
else
{
    foreach (var prontuario in ViewModel.Prontuarios)
    {
        if (prontuario.CrasId == ViewModel.LoggedTecnico.CrasAtivo.Id)
        {
            <ProntuarioCard Prontuario="prontuario" ComponentMode="ProntuarioCardTypeEnum.Editar"
                            ButtonProntuarioClicked="ViewModel.GoToEditarFamiliaCommand.ExecuteAsync"></ProntuarioCard>
        }
        else
        {
            <ProntuarioCard Prontuario="prontuario" ComponentMode="ProntuarioCardTypeEnum.Visualizar"
                            ButtonProntuarioClicked="ViewModel.GoToVisualizarFamiliaCommand.ExecuteAsync"></ProntuarioCard>
        }
    }
}

@code {

    protected override async Task<Task> OnInitializedAsync()
    {
        await ViewModel.GetLoggedUsuario();
        await ViewModel.GetAllProntuarios();
        return base.OnInitializedAsync();
    }

}
