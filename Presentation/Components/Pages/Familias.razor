@page "/familias"
@using SisCras.Presentation.Components.Shared
@inject FamiliaViewModel ViewModel
@inject NavigationManager NavigationManager

<PageTitle>Busca de Famílias</PageTitle>

<h3>Busca de Famílias</h3>

<div class="input-group mb-3">
<!--
    <input type="text" class="form-control" placeholder="Buscar por nome do responsável, CPF ou NIS..." @bind="termoBusca"/>
    <button class="btn btn-primary" type="button" @onclick="Buscar">Buscar</button>
    -->
</div>

<button class="btn btn-success mb-3" @onclick="ViewModel.GoToRegistrarFamiliaCommand.ExecuteAsync">Registrar Nova Família</button>

@if (ViewModel.Prontuarios == null)
{
    <p>Nenhum prontuário buscado</p>
}
else
{
    foreach (Prontuario prontuario in ViewModel.Prontuarios)
    {
        <ProntuarioCard Prontuario="prontuario" ComponentMode="ProntuarioCardTypeEnum.Editar" ButtonProntuarioClicked="ViewModel.GoToEditarFamiliaCommand.ExecuteAsync"></ProntuarioCard>
    }
}

@code {
    protected override async Task<Task> OnInitializedAsync()
    {
        await ViewModel.GetAllProntuarios();
        return base.OnInitializedAsync();
    }

}