@page "/admin"
@inject AdminViewModel ViewModel

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo Técnico
                    </h5>
                    <EditForm Model="ViewModel.NovoTecnico">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="fullName" class="form-label">* Nome Completo</label>
                            <InputText id="fullName" class="form-control" @bind-Value="ViewModel.NovoTecnico.Nome" placeholder="Nome do técnico" />
                            <ValidationMessage For="@(() => ViewModel.NovoTecnico.Nome)" />
                        </div>
                        <div class="mb-3">
                            <label for="username" class="form-label">* Nome de Usuário</label>
                            <InputText id="username" class="form-control" @bind-Value="ViewModel.NovoTecnico.Login" placeholder="usuario.exemplo" />
                            <ValidationMessage For="@(() => ViewModel.NovoTecnico.Login)" />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">* Senha</label>
                            <InputText id="password" type="password" class="form-control" @bind-Value="ViewModel.NovoTecnico.Senha" placeholder="Mínimo 6 caracteres" />
                            <ValidationMessage For="@(() => ViewModel.NovoTecnico.Senha)" />
                        </div>
                        <div class="mb-4">
                            <label for="confirmPassword" class="form-label">* Confirmar Senha</label>
                            <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="ViewModel.ConfirmarSenha" placeholder="Digite a senha novamente" />
                            <ValidationMessage For="@(() => ViewModel.ConfirmarSenha)" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center"
                                @onclick="ViewModel.AdicionarTecnicoCommand.ExecuteAsync">
                            <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Técnico
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-people-fill me-2"></i> Técnicos do Dona Tita
                    </h5>
                    @if (ViewModel.Tecnicos == null || !ViewModel.Tecnicos.Any())
                    {
                        <p>Nenhum técnico cadastrado.</p>
                    }
                    else if (ViewModel.BuscandoTecnicos)
                    {
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                            <p class="mb-1 text-muted">Buscando técnicos</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var tecnico in ViewModel.Tecnicos)
                        {
                            <div class="card mb-3 bg-light">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@tecnico.Nome</h6>
                                        <p class="text-muted mb-1">@tecnico.Login</p>
                                        <small class="text-muted">ID: @tecnico.Id</small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

