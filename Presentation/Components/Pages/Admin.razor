@page "/admin"
@using SisCras.Presentation.Components.Shared
@inject AdminViewModel ViewModel

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Novo Técnico
                    </h5>
                    <EditForm Model="ViewModel.NovoTecnico" OnValidSubmit="ViewModel.AdicionarTecnicoCommand.Execute">
                        
                        <FluentValidationValidator />
                        
                        <MaskedInput @bind-Value="ViewModel.NovoTecnico.Nome"
                                     Classes="mb-3"
                                     LabelTxt="Nome do técnico"
                                     Placeholder="O nome do técnico aqui"
                                     />
                        <MaskedInput @bind-Value="ViewModel.NovoTecnico.Login"
                                     Classes="mb-3"
                                     LabelTxt="Login do técnico"
                                     Placeholder="O login do técnico aqui"
                                     />
                        <MaskedInput @bind-Value="ViewModel.NovoTecnico.Senha"
                                     Classes="mb-3"
                                     LabelTxt="Senha do técnico"
                                     Placeholder="A senha com pelo menos 6 dígitos do técnico aqui"
                                     Type="password"
                                     />
                        <MaskedInput @bind-Value="@ViewModel.NovoTecnico.ConfSenha"
                                      Classes="mb-3"
                                      LabelTxt="Confirmar senha do técnico"
                                      Placeholder="Repita a senha aqui"
                                      Type="password"
                                      />
                        
                        <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-person-plus-fill me-2"></i> Cadastrar Técnico
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center mb-4">
                        <i class="bi bi-people-fill me-2"></i> Técnicos do @ViewModel.TecnicoLogado.CrasAtivo.Nome
                    </h5>
                    @if (ViewModel.Tecnicos == null || !ViewModel.Tecnicos.Any())
                    {
                        <p>Nenhum técnico cadastrado.</p>
                    }
                    else if (ViewModel.BuscandoTecnicos)
                    {
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                            <p class="mb-1 text-muted">Buscando técnicos</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var tecnico in ViewModel.Tecnicos)
                        {
                            <div class="card mb-3 bg-light">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1">@tecnico.Nome</h6>
                                        <p class="text-muted mb-1">@tecnico.Login</p>
                                        <small class="text-muted">ID: @tecnico.Id</small>
                                    </div>
                                    <button class="btn btn-outline-danger btn-sm" value="@tecnico.Id" @onclick="() => ViewModel.SolicitarRemocaoCommand.ExecuteAsync(tecnico) ">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<HxModal @ref="ViewModel.ConfirmationModal" 
         Title="Confirmar Exclusão" 
         Centered="true">
    <BodyTemplate>
        @if (ViewModel.TecnicoParaRemover != null)
        {
            <div class="alert alert-warning">
                Você está prestes a remover o técnico: <strong>@ViewModel.TecnicoParaRemover.Nome</strong> (@ViewModel.TecnicoParaRemover.Login).
                <br/>
                Essa ação não pode ser desfeita.
            </div>

            <div class="mb-3">
                <label class="form-label">Digite a senha do técnico para confirmar:</label>
                <InputText type="password" 
                           class="form-control" 
                           @bind-Value="ViewModel.SenhaUsuarioExclusao" 
                           placeholder="A senha do técnico" />
                
                @if (!string.IsNullOrEmpty(ViewModel.ErroModal))
                {
                    <div class="text-danger mt-2 small">
                        <i class="bi bi-exclamation-circle-fill"></i> @ViewModel.ErroModal
                    </div>
                }
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <HxButton Text="Cancelar" 
                  Color="ThemeColor.Secondary" 
                  OnClick="async () => await ViewModel.ConfirmationModal.HideAsync()" />
                  
        <HxButton Text="Confirmar Exclusão" 
                  Color="ThemeColor.Danger" 
                  OnClick="ViewModel.RemoverTecnicoCommand.ExecuteAsync" />
    </FooterTemplate>
</HxModal>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.BuscarTecnicos();
    }

}
