@using System.Globalization
@using SisCras.ApplicationLayer.Extensions
@using SisCras.Domain.Enums

@if (UsuarioModel != null)
{
    <div class="card mb-4">
        <div class="card-header @(UsuarioModel.Ativo ? "bg-primary" : "bg-warning") text-white">
            <h5 class="card-title mb-0">Membro da família</h5>
            <small class="card-subtitle">@UsuarioModel.Parentesco.GetDescription()</small><br/>
            <small class="card-subtitle">Data de inserção: @UsuarioModel.DataAdicao</small>
            @if (ComponentMode == MembroFamiliaTypeEnum.Editar)
            {
                <button
                    @onclick="() => TriggerDeactivateClicked(UsuarioModel)">@(UsuarioModel.Ativo ? "Reativar" : "Desativar")</button>
            }
            else if (ComponentMode == MembroFamiliaTypeEnum.Visualizar)
            {
                <button disabled="@AreInputsDisabled"
                        @onclick="() => TriggerDeactivateClicked(UsuarioModel)">@(UsuarioModel.Ativo ? "Reativar" : "Desativar")</button>
            }
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label fw-bold">Nome Completo *</label>
                    <InputText class="form-control form-control-lg" @bind-Value="UsuarioModel.Usuario.Nome"
                               placeholder="Nome completo" disabled="@AreInputsDisabled"/>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">CPF</label>
                    <MaskedInput @bind-Value="UsuarioModel.Usuario.Cpf" 
                                 Mask="MaskTypeEnum.Cpf"
                                 Placeholder="999.999.999-99"
                                 InputClass="form-control" 
                                 IsDisabled="AreInputsDisabled"/>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">RG</label>
                    <MaskedInput @bind-Value="UsuarioModel.Usuario.Rg" 
                                 Mask="MaskTypeEnum.Rg"
                                 Placeholder="999.999.999-99"
                                 InputClass="form-control"
                                 IsDisabled="AreInputsDisabled"/>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Sexo</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Usuario.Sexo" disabled="@AreInputsDisabled">
                        @foreach (SexoEnum sexo in Enum.GetValues(typeof(SexoEnum)))
                        {
                            <option value="@sexo">@sexo.GetDescription()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Raça/Cor</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Usuario.Raca" disabled="@AreInputsDisabled">
                        @foreach (RacaEnum raca in Enum.GetValues(typeof(RacaEnum)))
                        {
                            <option value="@raca">@raca.GetDescription()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Profissão</label>
                    <InputText class="form-control" @bind-Value="UsuarioModel.Usuario.Profissao"
                               placeholder="Profissão" disabled="@AreInputsDisabled"/>
                </div>
            </div>

            <hr class="my-4"/>

            <div class="row g-3">
                <!-- NIS -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">NIS</label>
                    <MaskedInput @bind-Value="UsuarioModel.Usuario.Nis" 
                                 Mask="MaskTypeEnum.Cpf"
                                 Placeholder="999.999.999-99"
                                 InputClass="form-control"
                                 IsDisabled="AreInputsDisabled"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Data de Nascimento</label>
                    <InputDate class="form-control" @bind-Value="UsuarioModel.Usuario.DataNascimento" disabled="@AreInputsDisabled"/>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Estado Civil</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Usuario.EstadoCivil" disabled="@AreInputsDisabled">
                        @foreach (EstadoCivilEnum estado in Enum.GetValues(typeof(EstadoCivilEnum)))
                        {
                            <option value="@estado">@estado.GetDescription()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Grau de Instrução</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Usuario.Escolaridade" disabled="@AreInputsDisabled">
                        @foreach (EscolaridadeEnum escolaridade in Enum.GetValues(typeof(EscolaridadeEnum)))
                        {
                            <option value="@escolaridade">@escolaridade.GetDescription()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Orientação Sexual</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Usuario.OrientacaoSexual" required disabled="@AreInputsDisabled">
                        @foreach (OrientacaoSexualEnum orientacaoSexual in Enum.GetValues(typeof(OrientacaoSexualEnum)))
                        {
                            <option value="@orientacaoSexual">@orientacaoSexual.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
                
                <div class="col-md-6">
                    <MaskedInput
                        @bind-Value="RendaBrutaString"
                        Mask="MaskTypeEnum.Dinheiro"
                        Placeholder="0,00"
                        Classes="rounded-pill border border-light"
                        InputClass="form-control"
                        Type="text"
                        IsDisabled="AreInputsDisabled">
                        
                        <PrefixContent>
                            <span class="input-group-text bg-transparent border-0 text-white-50 pe-1">
                                R$
                            </span>
                        </PrefixContent>
                    </MaskedInput>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <p class="mb-0"><em>Usuário não foi fornecido.</em></p>
    </div>
}

@code {
    [Parameter] public FamiliaUsuario UsuarioModel { get; set; }
    [Parameter] public MembroFamiliaTypeEnum ComponentMode { get; set; }

    [Parameter] public EventCallback DeactivateClicked { get; set; }
    
    public string RendaBrutaString 
    { 
        get 
        {
            if (UsuarioModel?.Usuario == null) return string.Empty;
            return UsuarioModel.Usuario.RendaBruta.ToString(CultureInfo.InvariantCulture);
        }
        set 
        {
            if (UsuarioModel?.Usuario != null && 
                float.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out float parsedFloat))
            {
                UsuarioModel.Usuario.RendaBruta = parsedFloat;
            }
            else if (UsuarioModel?.Usuario != null && string.IsNullOrEmpty(value))
            {
                UsuarioModel.Usuario.RendaBruta = 0f;
            }
        }
    }

    public bool AreInputsDisabled
    {
        get => (ComponentMode == MembroFamiliaTypeEnum.Visualizar);
    }

    public async Task TriggerDeactivateClicked(FamiliaUsuario usuario)
    {
        await DeactivateClicked.InvokeAsync(usuario);
    }
}
