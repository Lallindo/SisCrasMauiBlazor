@using Domain.Entities.Enums
@using SisCras.ApplicationLayer.Extensions

@if (UsuarioModel != null)
{
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="card-title mb-0">Membro @UsuarioModel.Id</h5>
            <small class="card-subtitle">Responsável</small>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-12">
                    <label class="form-label fw-bold">Nome Completo *</label>
                    <InputText class="form-control form-control-lg" @bind-Value="UsuarioModel.Nome" 
                               placeholder="Nome completo" />
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">CPF</label>
                    <InputText class="form-control" @bind-Value="UsuarioModel.Cpf" 
                               placeholder="000.000.000-00" />
                </div>
                
                <div class="col-md-4">
                    <label class="form-label fw-bold">Sexo</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Sexo">
                        <option value="">Selecione</option>
                        @foreach (SexoEnum sexo in Enum.GetValues(typeof(SexoEnum)))
                        {
                            <option value="@sexo">@sexo.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
                
                <div class="col-md-4">
                    <label class="form-label fw-bold">Raça/Cor</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Raca">
                        <option value="">Selecione</option>
                        @foreach (RacaEnum raca in Enum.GetValues(typeof(RacaEnum)))
                        {
                            <option value="@raca">@raca.GetDescription()</option>
                        }
                    </InputSelect>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-bold">Profissão</label>
                    <InputText class="form-control" @bind-Value="UsuarioModel.Profissao" 
                               placeholder="Profissão" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-3">
                <!-- NIS -->
                <div class="col-md-6">
                    <label class="form-label fw-bold">NIS</label>
                    <InputText class="form-control" @bind-Value="UsuarioModel.Nis" 
                               placeholder="Número do NIS" />
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Data de Nascimento</label>
                    <InputDate class="form-control" @bind-Value="UsuarioModel.DataNascimento" />
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Estado Civil</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.EstadoCivil">
                        <option value="">Selecione</option>
                        @foreach (EstadoCivilEnum estado in Enum.GetValues(typeof(EstadoCivilEnum)))
                        {
                            <option value="@estado">@estado.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label fw-bold">Grau de Instrução</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.Escolaridade">
                        <option value="">Selecione</option>
                        @foreach (EscolaridadeEnum escolaridade in Enum.GetValues(typeof(EscolaridadeEnum)))
                        {
                            <option value="@escolaridade">@escolaridade.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label">Orientação Sexual</label>
                    <InputSelect class="form-select" @bind-Value="UsuarioModel.OrientacaoSexual" required>
                        <option value="">Selecione...</option>
                        @foreach (OrientacaoSexualEnum orientacaoSexual in Enum.GetValues(typeof(OrientacaoSexualEnum)))
                        {
                            <option value="@orientacaoSexual">@orientacaoSexual.GetDescription()</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        <p class="mb-0"><em>Usuário não foi fornecido.</em></p>
    </div>
}

@code {
    [Parameter]
    public Usuario UsuarioModel { get; set; }   
    [Parameter]
    public int UsuarioNumber { get; set; }
}