@using System.Linq.Expressions
@using SisCras.Presentation.Enums
@using Microsoft.AspNetCore.Components.Forms
@using SisCras.ApplicationLayer.Extensions

<div class="@Classes">
    <label class="form-label fw-bold">@LabelTxt</label>
    
    <div class="input-group">
        @if (PrefixContent != null)
        {
            @PrefixContent
        }

        <InputText type="@Type"
                   class="@_inputClass"
                   Value="@Value"
                   ValueChanged="@OnChange"
                   ValueExpression="@ValueExpression"
                   placeholder="@Placeholder"
                   disabled="@IsDisabled"
                   @onfocusout="OnFocusOut"/>
    </div>
    <ValidationMessage For="@ValueExpression" class="text-danger small"/>
</div>

@code {
    // 1. Renomeado para 'Value' para funcionar nativamente com @bind-Value no pai
    [Parameter]
    public string? Value { get; set; }
    
    [Parameter]
    public string LabelTxt { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    // 2. O PARÂMETRO MÁGICO: Recebe a expressão lambda do pai (ex: () => model.Cpf)
    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter]
    public MaskTypeEnum Mask { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? InputClass { get; set; }

    private string? _inputClass => $"form-control {InputClass}"; 

    [Parameter]
    public string? Classes { get; set; }
  
    [Parameter]
    public EventCallback OnFocusOut { get; set; }

    [Parameter]
    public string Type { get; set; } = "text";

    [Parameter]
    public RenderFragment? PrefixContent { get; set; }

    [Parameter] 
    public bool IsDisabled { get; set; } = false; 

    // Ajuste no OnChange para usar o ValueChanged correto
    private async Task OnChange(string? value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(Value);
    }
}
