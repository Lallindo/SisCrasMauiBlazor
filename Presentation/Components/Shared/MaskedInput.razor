@using SisCras.Presentation.Enums
@using Microsoft.AspNetCore.Components.Forms

@* Exemplo simplificado da estrutura - Você precisará da lógica de máscara (JS ou C#) *@
<div class="@Classes">
  <div class="input-group">
    @if (PrefixContent != null)
    {
      @PrefixContent
    }
        
    @* Input real onde a máscara seria aplicada *@
    <input type="@Type" 
           class="@InputClass" 
           value="@Value"
           placeholder="@Placeholder"
           disabled="@IsDisabled"
           @onchange="OnChange" 
           @onfocusout="OnFocusOut"/>
  </div>
</div>

@code {
  [Parameter]
  public string? Value { get; set; }

  [Parameter]
  public EventCallback<string?> ValueChanged { get; set; }

  [Parameter]
  public MaskTypeEnum Mask { get; set; }

  [Parameter]
  public string? Placeholder { get; set; }

  [Parameter]
  public string? InputClass { get; set; }

  [Parameter]
  public string? Classes { get; set; }
  
  [Parameter]
    public EventCallback OnFocusOut { get; set; }

  [Parameter]
  public string Type { get; set; } = "text";

  [Parameter]
  public RenderFragment? PrefixContent { get; set; }

  [Parameter] public bool IsDisabled { get; set; } = false; 

  private async Task OnChange(ChangeEventArgs e)
  {
    Value = e.Value?.ToString();
    await ValueChanged.InvokeAsync(Value);
  }
}
