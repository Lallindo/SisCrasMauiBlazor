@using SisCras.ApplicationLayer.Extensions
<div class="card">
    <div class="card-header">
        <p class="card-title">
            Prontuário @Prontuario.Codigo
        </p>
    </div>
    <div class="card-body">
        <p class="card-text">Nome do responsável: @Prontuario.Familia.Responsavel.Nome</p>
        <p class="card-text">Data de criação: @Prontuario.DataCriacao</p>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary"
            @onclick="() => TriggerEditProntuario()">@ComponentMode.GetDescription()</button>
    </div>
</div>

@code {
    [Parameter] public Prontuario Prontuario { get; set; }
    [Parameter] public ProntuarioCardTypeEnum ComponentMode { get; set; }
    [Parameter] public EventCallback ButtonProntuarioClicked { get; set; }

    public async Task TriggerEditProntuario()
    {
        await ButtonProntuarioClicked.InvokeAsync(Prontuario.FamiliaId);
    }
}