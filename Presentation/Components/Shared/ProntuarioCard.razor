@using SisCras.ApplicationLayer.Extensions
<div class="card">
    <div class="card-header @(Prontuario.ProntuarioAtivo != null ? "bg-white" : "bg-warning")">
        <p class="card-title">
            Prontuário @Prontuario.Id
        </p>
    </div>
    <div class="card-body">
        <p class="card-text">Nome do responsável: @ResponsavelName</p>
        <p class="card-text">Data de criação: @Prontuario.ProntuarioAtivo.DataEntrada</p>
        <p class="card-text">Cras: @Prontuario.Cras.Nome</p>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary"
                @onclick="@(() => TriggerButtonProntuario())">@ComponentMode.GetDescription()</button>
        @if (ComponentMode == ProntuarioCardTypeEnum.Editar)
        {
            <button class="btn btn-danger"
                    @onclick="@(() => TriggerChangeProntuario())">Desativar</button>
        }
        else
        {
            <button class="btn btn-warning"
                    @onclick="@(() => TriggerChangeProntuario())">Importar</button>
        }
    </div>
</div>

@code {
    [Parameter] public Prontuario Prontuario { get; set; }
    [Parameter] public ProntuarioCardTypeEnum ComponentMode { get; set; }
    [Parameter] public EventCallback ButtonProntuarioClicked { get; set; }
    [Parameter] public EventCallback ButtonChangeClicked { get; set; }

    private string ResponsavelName
    {
        get
        {
            var resp = Prontuario.Familia.Responsavel;
            if (resp is null) return "Nenhum responsável encontrado";
            return resp.Nome;
        }
    }

    private async Task TriggerButtonProntuario()
    {
        await ButtonProntuarioClicked.InvokeAsync(Prontuario.FamiliaId);
    }

    private async Task TriggerChangeProntuario()
    {
        await ButtonChangeClicked.InvokeAsync(Prontuario);
    }
}
