@inject HeaderViewModel ViewModel
@using System.ComponentModel
@implements IDisposable

<header class="siscras-header sticky-top shadow-lg">
    <div class="siscras-container">
        <div class="header-content">
            <div class="header-left" @onclick="ViewModel.GoToHomeCommand.ExecuteAsync">
                <div class="logo-container">
                    <img src="resources/brasao_jau.jpg" alt="Brasão de Jaú" class="logo-img" />
                </div>
                <div>
                    <h1 class="title">SisCras</h1>
                    <p class="subtitle">
                        @if (ViewModel.IsTecnicoLoggedIn)
                        {
                            <span>CRAS @ViewModel.Tecnico?.CrasAtivo.Nome</span>
                        }
                        else
                        {
                            <span>Centro de Referência da Assistência Social</span>
                        }
                        - Jaú/SP
                    </p>
                </div>
            </div>

            @if (ViewModel.IsTecnicoLoggedIn)
            {
                <div class="header-right">
                    @if (ViewModel.Tecnico.IsAdmin)
                    {
                        <div>
                            <button class="btn btn-secondary" @onclick="@ViewModel.GoToAdminCommand.ExecuteAsync">
                                Admin
                            </button>
                        </div>   
                    }

                    <div class="user-info">
                        <div class="user-name">
                            <span class="bi bi-person-fill" aria-hidden="true"></span>
                            <span>@ViewModel.Tecnico?.Nome</span>
                        </div>
                        <p class="user-cras">@ViewModel.Tecnico?.CrasAtivo.Nome</p>
                    </div>

                    <button class="btn btn-ghost" @onclick="@ViewModel.LogoutTecnicoCommand.Execute">
                        <span class="bi bi-box-arrow-right" aria-hidden="true"></span>
                        <span class="btn-text">Sair</span>
                    </button>
                </div>
            }
            else
            {
                <div class="header-right">
                    <button class="btn btn-ghost" @onclick="@ViewModel.GoToLoginCommand.ExecuteAsync">
                        <span class="bi bi-box-arrow-left" aria-hidden="true"></span>
                        <span class="btn-text">Fazer login</span>
                    </button>
                </div>
            }
        </div>
    </div>
</header>

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    }

    private async void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // Força a re-renderização do componente
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }

}
