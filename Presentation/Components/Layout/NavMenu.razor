@inject HeaderViewModel ViewModel
@using System.ComponentModel
@implements IDisposable

@if (ViewModel is not null)
{
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            
            <div>
                <h1>SisCras</h1>
                <h6>@ViewModel.Tecnico?.CrasInfoProp.Nome</h6>
            </div>
            
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="familias">
                            <span class="bi bi-people-fill" aria-hidden="true"></span> Famílias
                        </NavLink>
                    </li>
                </ul>

                <div class="navbar-nav">
                    @if (ViewModel.IsTecnicoLoggedIn)
                    {
                        <li class="nav-item">
                            <span class="navbar-text">
                                @ViewModel.Tecnico?.Nome
                            </span>
                        </li>
                        
                        <li class="nav-item">
                            <button class="btn btn-link nav-link btn-danger" @onclick="@ViewModel.LogoutTecnicoCommand.ExecuteAsync">
                                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Sair
                            </button>
                        </li>
                    }
                </div>
            </div> 
        </div> 
    </nav>
}

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    }

    private void GoToLogin()
    {
        ViewModel.GoToLogin();
    }

    private async void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // Força a re-renderização do componente
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    }

}
